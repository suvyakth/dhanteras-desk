# Copy to .env and fill in. .env is gitignored.
# Free OpenAI-compatible LLM endpoint (Groq free tier works).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional per-agent model (Groq rate limits are per model)
CRITIC_MODEL=qwen/qwen3.8-27b

# Lyzr Studio > Account > API Keys. The agents think with Lyzr.
LYZR_API_KEY=

# Agent37 > Cloud API > API keys (only needed to deploy)
AGENT37_API_KEY=
